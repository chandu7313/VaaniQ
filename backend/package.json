{
  "name": "vaaniq-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node --env-file-if-exists=../.env.test --test --test-concurrency=1 test/*.test.js",
    "lint": "node --check src/server.js && node scripts/lint.mjs",
    "db:reset": "node --env-file-if-exists=../.env src/db/reset.js",
    "start:prod": "node src/db/migrate.js && node src/db/seed.js && node src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
