{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vaaniq/config_file.schema.json",
  "title": "Knowledge-base config file envelope",
  "type": "object",
  "required": ["schema_version", "file_id", "tenant_slug", "fictional_demo_data", "authority_level", "last_updated", "approval_status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "file_id": { "type": "string", "pattern": "^ABC-GHR-CFG-[0-9]{2}$" },
    "tenant_slug": { "const": "abc-developers" },
    "fictional_demo_data": { "const": true },
    "authority_level": { "type": "integer", "minimum": 1, "maximum": 4, "description": "1 = highest (structured config / live DB)." },
    "last_updated": { "type": "string", "format": "date" },
    "approval_status": { "enum": ["APPROVED", "PENDING_REVIEW", "DRAFT"] },
    "retrievable_by_rag": { "type": "boolean", "description": "false for trusted backend configuration that must not be served as retrievable content." }
  }
}
