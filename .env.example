# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://vaaniq:vaaniq@localhost:5432/vaaniq
DB_POOL_MAX=10
# TLS for hosted Postgres: false | require | verify. Supabase: use the *Session pooler* URL
# (Dashboard > Connect; host aws-*.pooler.supabase.com, user postgres.<project-ref>) with DATABASE_SSL=require.
# The direct host db.<ref>.supabase.co is IPv6-only and fails on most IPv4 networks.
DATABASE_SSL=false
# Optional CA bundle path when DATABASE_SSL=verify (e.g. Supabase's downloadable root certificate)
DATABASE_SSL_CA_FILE=

# ---- Auth (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Used only by `npm run seed` to create the demo admin (admin@abcdevelopers.demo).
# If empty, the seed generates a random password and prints it once.
SEED_ADMIN_PASSWORD=

# ---- AI provider: groq | gemini | demo ----
# With no API key the app runs in an explicitly labelled DEMO_MODE (rule-based NLU + templated replies).
LLM_PROVIDER=demo
LLM_API_KEY=
# Model names change often: check the provider's current model list before setting.
LLM_MODEL=
LLM_TIMEOUT_MS=15000
# Force demo mode even when a key is present
DEMO_MODE=false

# ---- Rate limits ----
RATE_LIMIT_MAX=300
AGENT_RATE_LIMIT_MAX=60
